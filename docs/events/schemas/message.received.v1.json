{
  "$defs": {
    "Channel": {
      "description": "Мессенджер или виджет, через который клиент пишет салону.",
      "enum": [
        "telegram",
        "telegram_business",
        "vk",
        "max",
        "web",
        "api"
      ],
      "title": "Channel",
      "type": "string"
    },
    "MessageReceivedData": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "client_id": {
          "format": "uuid",
          "title": "Client Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "conversation_id",
        "client_id",
        "channel"
      ],
      "title": "MessageReceivedData",
      "type": "object"
    }
  },
  "$id": "https://github.com/Bananas1631/Ai-beauty-agent/docs/events/schemas/message.received.v1.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/MessageReceivedData"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "salon_id": {
      "format": "uuid",
      "title": "Salon Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "message.received",
      "default": "message.received",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "salon_id",
    "data"
  ],
  "title": "MessageReceived",
  "type": "object"
}
