{
  "$defs": {
    "BookingAttributedData": {
      "additionalProperties": false,
      "description": "Запись засчитана ИИ по правилу тарифа «Результат» (domain/billing.py): визит наступил.",
      "properties": {
        "billing_month": {
          "pattern": "^\\d{4}-\\d{2}$",
          "title": "Billing Month",
          "type": "string"
        },
        "booking_id": {
          "format": "uuid",
          "title": "Booking Id",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BookingStatus"
        }
      },
      "required": [
        "booking_id",
        "starts_at",
        "status",
        "billing_month"
      ],
      "title": "BookingAttributedData",
      "type": "object"
    },
    "BookingStatus": {
      "description": "Статус записи клиента.",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed",
        "no_show"
      ],
      "title": "BookingStatus",
      "type": "string"
    }
  },
  "$id": "https://github.com/Bananas1631/Ai-beauty-agent/docs/events/schemas/booking.attributed.v1.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/BookingAttributedData"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "salon_id": {
      "format": "uuid",
      "title": "Salon Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "booking.attributed",
      "default": "booking.attributed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "salon_id",
    "data"
  ],
  "title": "BookingAttributed",
  "type": "object"
}
