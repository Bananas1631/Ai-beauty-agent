{
  "$defs": {
    "LlmCallFinishedData": {
      "additionalProperties": false,
      "description": "Ход агента завершён: модель, токены, стоимость. model=None — ответ без модели (кэш, guardrail).",
      "properties": {
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "completion_tokens": {
          "minimum": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "cost_rub": {
          "title": "Cost Rub",
          "type": "string"
        },
        "guardrail": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guardrail"
        },
        "handed_off": {
          "default": false,
          "title": "Handed Off",
          "type": "boolean"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "offers_shown": {
          "default": 0,
          "minimum": 0,
          "title": "Offers Shown",
          "type": "integer"
        },
        "prompt_tokens": {
          "minimum": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "conversation_id",
        "prompt_version",
        "prompt_tokens",
        "completion_tokens",
        "cost_rub",
        "latency_ms",
        "tool_calls"
      ],
      "title": "LlmCallFinishedData",
      "type": "object"
    }
  },
  "$id": "https://github.com/Bananas1631/Ai-beauty-agent/docs/events/schemas/llm.call.finished.v1.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/LlmCallFinishedData"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "salon_id": {
      "format": "uuid",
      "title": "Salon Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "llm.call.finished",
      "default": "llm.call.finished",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "salon_id",
    "data"
  ],
  "title": "LlmCallFinished",
  "type": "object"
}
