{
  "$defs": {
    "KnowledgeUpdatedData": {
      "additionalProperties": false,
      "description": "Индексатор закончил обход: новая версия базы знаний сайта — ключ кэша ответов меняется.",
      "properties": {
        "chunks": {
          "default": 0,
          "minimum": 0,
          "title": "Chunks",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "pages_indexed": {
          "default": 0,
          "minimum": 0,
          "title": "Pages Indexed",
          "type": "integer"
        },
        "pages_seen": {
          "default": 0,
          "minimum": 0,
          "title": "Pages Seen",
          "type": "integer"
        },
        "pages_unchanged": {
          "default": 0,
          "minimum": 0,
          "title": "Pages Unchanged",
          "type": "integer"
        },
        "status": {
          "enum": [
            "done",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "status"
      ],
      "title": "KnowledgeUpdatedData",
      "type": "object"
    }
  },
  "$id": "https://github.com/Bananas1631/Ai-beauty-agent/docs/events/schemas/knowledge.updated.v1.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/KnowledgeUpdatedData"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "salon_id": {
      "format": "uuid",
      "title": "Salon Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "knowledge.updated",
      "default": "knowledge.updated",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "salon_id",
    "data"
  ],
  "title": "KnowledgeUpdated",
  "type": "object"
}
