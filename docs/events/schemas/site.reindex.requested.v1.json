{
  "$defs": {
    "SiteReindexRequestedData": {
      "additionalProperties": false,
      "description": "Основной сервис просит индексатор обойти сайт салона (ADR 014). Адрес сайта салона —\nпубличные данные, не персональные.",
      "properties": {
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "max_pages": {
          "default": 30,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "site_url": {
          "maxLength": 2048,
          "title": "Site Url",
          "type": "string"
        }
      },
      "required": [
        "site_url"
      ],
      "title": "SiteReindexRequestedData",
      "type": "object"
    }
  },
  "$id": "https://github.com/Bananas1631/Ai-beauty-agent/docs/events/schemas/site.reindex.requested.v1.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/SiteReindexRequestedData"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "salon_id": {
      "format": "uuid",
      "title": "Salon Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "const": "site.reindex.requested",
      "default": "site.reindex.requested",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "salon_id",
    "data"
  ],
  "title": "SiteReindexRequested",
  "type": "object"
}
