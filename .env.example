# Образец настроек. Скопируйте в .env и заполните: .env в git не попадает.
# Пустое значение — используется значение по умолчанию из core/config.py.

# Приложение
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beauty
POSTGRES_DB=beauty

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM — ключ из менеджера паролей
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# YCLIENTS — токен партнёра из менеджера паролей
YCLIENTS_BASE_URL=https://api.yclients.ru/api/v1
YCLIENTS_PARTNER_TOKEN=
# токен сотрудника салона: поиск записи после таймаута создания
YCLIENTS_USER_TOKEN=

# RabbitMQ — очередь фоновых задач (с 2 ноября); пока нужен только самому контейнеру
RABBITMQ_USER=beauty
RABBITMQ_PASSWORD=beauty

# Sentry или self-hosted GlitchTip; пустой DSN — отправка ошибок выключена
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Только для сервера (deploy/docker-compose.prod.yml и deploy/backup.sh)
APP_IMAGE=
DOMAIN=
ACME_EMAIL=
REDIS_PASSWORD=
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE=
