# Образец настроек. Скопируйте в .env и заполните: .env в git не попадает.
# Пустое значение — используется значение по умолчанию из core/config.py.

# Приложение
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beauty
POSTGRES_DB=beauty

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM — ключи из менеджера паролей. Клиент создаётся только для провайдера с ключом
# Cloud.ru Foundation Models: Qwen3-235B (основная модель)
LLM_CLOUDRU_API_KEY=
# Yandex AI Studio: YandexGPT Lite и Pro
LLM_YANDEX_API_KEY=
LLM_YANDEX_FOLDER_ID=
# GigaChat (резервная): ключ авторизации и путь к корневому сертификату НУЦ Минцифры
LLM_GIGACHAT_AUTH_KEY=
LLM_GIGACHAT_CA_BUNDLE=
# Эмбеддинги для RAG (Cloud.ru, тот же ключ). Без ключа — офлайн-хеширование.
# Смена модели требует переиндексации базы знаний
LLM_EMBEDDINGS_MODEL=BAAI/bge-m3
# Порядок моделей: основная, затем резервные
LLM_DEFAULT_MODELS=["qwen3-235b", "gigachat-2-lite"]
# Кэш ответов на вопросы о салоне (ADR 011): точный — включён; семантический — эксперимент,
# включать только после прогона evals --cache semantic с тем же гейтом качества
LLM_ANSWER_CACHE=true
LLM_SEMANTIC_CACHE=false
# Векторы сообщений клиентов с согласием на ПДн — поиск по истории для администратора
LLM_HISTORY_EMBEDDINGS=true
# Фото-референсы: мультимодальная модель. Пусто — Cloud.ru с LLM_CLOUDRU_API_KEY; без ключей фото
# уходят администратору. Подбор услуги по фото включается настройкой салона photo_mode=guess
LLM_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
# Свой OpenAI-совместимый сервер (vLLM, Ollama) — модель «custom»
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Kafka — журнал доменных событий (ADR 013). С хоста — localhost:9094, в Docker — kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_PARTITIONS=6
KAFKA_RETENTION_DAYS=7
# Еженедельный отчёт из статистики событий — включать после первой полной недели работы consumers
KAFKA_ENABLED=false
# Только на сервере: ID кластера KRaft, один раз (base64 от UUID, см. docker-compose.prod.yml)
KAFKA_CLUSTER_ID=

# YCLIENTS — токен партнёра из менеджера паролей
YCLIENTS_BASE_URL=https://api.yclients.ru/api/v1
YCLIENTS_PARTNER_TOKEN=
# токен сотрудника салона: поиск записи после таймаута создания
YCLIENTS_USER_TOKEN=

# RabbitMQ — очередь Celery: входящие сообщения мессенджеров и фоновые задачи
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=beauty
RABBITMQ_PASSWORD=beauty

# Админ-бот: один Telegram-бот для администраторов всех салонов (черновики, уведомления, /token)
ADMIN_BOT_TOKEN=
ADMIN_BOT_USERNAME=

# Мессенджер MAX: сервер API на сертификате Минцифры — путь к корневому сертификату (docs/integrations/max.md)
MAX_API_URL=https://platform-api2.max.ru
MAX_CA_BUNDLE=

# Мониторинг (профиль monitoring в docker-compose): пароль Grafana и отдельный Telegram-бот для алертов
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ALERT_BOT_TOKEN=
GRAFANA_ALERT_CHAT_ID=

# Ключи безопасности. В проде обязательны, локально без них — известные dev-ключи.
# Fernet (токены ботов в БД), через запятую для ротации — новый первым:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_FERNET_KEYS=
# Секрет вебхуков каналов и JWT API инбокса: openssl rand -hex 32
SECURITY_WEBHOOK_KEY=
SECURITY_JWT_SECRET=

# Sentry или self-hosted GlitchTip; пустой DSN — отправка ошибок выключена
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Только для сервера (deploy/docker-compose.prod.yml и deploy/backup.sh)
APP_IMAGE=
DOMAIN=
ACME_EMAIL=
REDIS_PASSWORD=
BACKUP_GPG_RECIPIENT=
BACKUP_REMOTE=

# Langfuse — трассировка диалогов (self-hosted в РФ, deploy/docker-compose.langfuse.yml).
# Без ключей трассировка выключена
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENVIRONMENT=local
LANGFUSE_SAMPLE_RATE=1.0
