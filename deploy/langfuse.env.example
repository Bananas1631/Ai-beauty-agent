# Секреты self-hosted Langfuse. Скопировать в deploy/langfuse.env (в git не попадает) и заполнить:
#   openssl rand -hex 32
LANGFUSE_URL=https://langfuse.example.ru
LANGFUSE_DB_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
